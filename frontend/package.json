{
  "name": "xyai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src --fix",
    "sync:dist": "powershell -Command \"Remove-Item -Recurse -Force ..\\src\\main\\resources\\static\\* -ErrorAction SilentlyContinue; Copy-Item -Path dist\\* -Destination ..\\src\\main\\resources\\static -Recurse -Force\"",
    "build:sync": "npm run build && npm run sync:dist"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.2",
    "katex": "^0.16.9",
    "dompurify": "^3.0.6",
    "marked-gfm-heading-id": "^3.1.0",
    "marked-toc": "^0.1.1",
    "pinia": "^2.1.3",
    "vue": "^3.3.4",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.2",
    "vite": "^5.0.0"
  }
}
